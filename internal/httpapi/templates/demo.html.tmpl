<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>vouchsafe</title>
<style>
  body{font-family:system-ui,sans-serif;max-width:560px;margin:40px auto;padding:0 16px;color:#1a1a2e}
  h1{font-size:1.4rem}
  .row{display:flex;gap:8px;margin:12px 0}
  input{flex:1;padding:8px;font-size:1rem}
  button{padding:8px 16px;font-size:1rem;cursor:pointer}
  pre{background:#f4f4f8;padding:12px;border-radius:6px;overflow-x:auto;white-space:pre-wrap;word-break:break-all}
  .ok{color:#1a7f37}
  .err{color:#cf222e}
</style>
</head>
<body>
<h1>vouchsafe &mdash; passkey login, no dependencies</h1>
<p>rp_id={{.RPID}} &middot; no certificate, no library, nothing installed.</p>

<div class="row">
  <input id="username" placeholder="username" autocomplete="username" value="alice">
</div>
<div class="row">
  <button id="registerBtn">Register</button>
  <button id="loginBtn">Log in</button>
</div>
<pre id="status">Ready.</pre>

<script>
function b64urlToBuf(s) {
  s = s.replace(/-/g, '+').replace(/_/g, '/');
  while (s.length % 4) s += '=';
  const bin = atob(s);
  const buf = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i++) buf[i] = bin.charCodeAt(i);
  return buf.buffer;
}
function bufToB64url(buf) {
  const bytes = new Uint8Array(buf);
  let bin = '';
  for (let i = 0; i < bytes.length; i++) bin += String.fromCharCode(bytes[i]);
  return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}
function setStatus(msg, cls) {
  const el = document.getElementById('status');
  el.textContent = msg;
  el.className = cls || '';
}
function username() { return document.getElementById('username').value; }

async function post(path, body) {
  const res = await fetch(path, {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify(body),
  });
  const text = await res.text();
  const data = text ? JSON.parse(text) : {};
  if (!res.ok) throw new Error(data.error || ('HTTP ' + res.status));
  return data;
}

document.getElementById('registerBtn').addEventListener('click', async () => {
  try {
    setStatus('Requesting challenge...');
    const opts = await post('/register/begin', {username: username()});
    opts.challenge = b64urlToBuf(opts.challenge);
    opts.user.id = b64urlToBuf(opts.user.id);

    setStatus('Touch your sensor or security key...');
    const cred = await navigator.credentials.create({publicKey: opts});

    await post('/register/finish', {
      username: username(),
      rawId: bufToB64url(cred.rawId),
      clientDataJSON: bufToB64url(cred.response.clientDataJSON),
      attestationObject: bufToB64url(cred.response.attestationObject),
    });
    setStatus('Registered. No certificate, no library, nothing installed.', 'ok');
  } catch (err) {
    setStatus('Registration failed: ' + err.message, 'err');
  }
});

document.getElementById('loginBtn').addEventListener('click', async () => {
  try {
    setStatus('Requesting challenge...');
    const opts = await post('/login/begin', {username: username()});
    opts.challenge = b64urlToBuf(opts.challenge);
    if (opts.allowCredentials) {
      opts.allowCredentials = opts.allowCredentials.map(c => Object.assign({}, c, {id: b64urlToBuf(c.id)}));
    }

    setStatus('Touch your sensor or security key...');
    const cred = await navigator.credentials.get({publicKey: opts});

    const result = await post('/login/finish', {
      username: username(),
      rawId: bufToB64url(cred.rawId),
      clientDataJSON: bufToB64url(cred.response.clientDataJSON),
      authenticatorData: bufToB64url(cred.response.authenticatorData),
      signature: bufToB64url(cred.response.signature),
    });
    setStatus('Logged in as ' + result.user + ' (uv=' + result.uv + '). Steal vouchsafe.json and you get nothing you can log in with -- there are no passwords here.', 'ok');
  } catch (err) {
    setStatus('Login failed: ' + err.message, 'err');
  }
});
</script>
</body>
</html>
